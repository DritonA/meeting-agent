# Copy this file to .env and fill in what you need.

# --- Notes (Claude) -------------------------------------------------------
# Required for AI meeting notes. Without it you still get the full transcript.
ANTHROPIC_API_KEY=
# Model used to write the notes.
NOTES_MODEL=claude-opus-5-5

# --- Bot -------------------------------------------------------------------
# Name shown to other participants (used when joining as a guest).
BOT_NAME=Meeting Notetaker
# "chrome" uses your installed Google Chrome (recommended). "chromium" uses Playwright's bundled browser.
BROWSER_CHANNEL=chrome
# false = you see the bot's browser window (most reliable with Google Meet).
HEADLESS=false
# Where the bot's Chrome profile lives. Sign in once with `npm run login` to join as a Google account.
PROFILE_DIR=./.bot-profile
# How long to wait for the host to admit the bot (minutes).
ADMIT_TIMEOUT_MINUTES=15
# Leave automatically after being the only participant for this long (minutes).
ALONE_TIMEOUT_MINUTES=3
# Hard stop for any meeting (minutes).
MAX_MEETING_MINUTES=240
# Record meeting audio as a backup (audio.webm in the meeting folder).
RECORD_AUDIO=true

# --- Language --------------------------------------------------------------
# Language the bot selects for Meet's captions, as Meet names it. Must match what people speak,
# otherwise captions come out as nonsense. Empty = keep Meet's default (usually English).
CAPTION_LANGUAGE=Albanian
# Language for notes.md (e.g. Albanian, English). Empty = same language as the meeting.
NOTES_LANGUAGE=

# --- Optional: second transcript from the audio recording ------------------
# After the meeting, the recorded audio can also be transcribed by Soniox or Deepgram, with
# speakers matched to participant names using the live captions. It fills gaps the captions missed.
# Which service to use: soniox, deepgram, none. Empty = the first one that has a key (Soniox first).
# You can also re-run it later from the web app with either service.
TRANSCRIPTION_PROVIDER=soniox
# Language code of the speech: "sq" = Albanian. Empty = let the service detect it.
TRANSCRIPTION_LANGUAGE=sq
# Soniox (https://soniox.com) — lists Albanian as supported.
SONIOX_API_KEY=
SONIOX_MODEL=stt-async-v6
# Deepgram (https://deepgram.com) — Albanian support not confirmed.
DEEPGRAM_API_KEY=

# --- Web UI ----------------------------------------------------------------
PORT=3000
DATA_DIR=./data/meetings
